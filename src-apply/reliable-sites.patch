The upstream default sites caused MANY failed nightly runs of DanielMYT's
musl-cross-make-nightly repository. Change them to more safe and reliable
values (in particular, explicitly pick a GNU mirror instead of letting the
main GNU site pick for us).

diff --git a/Makefile b/Makefile
index d8b8d35..1cd57bb 100644
--- a/Makefile
+++ b/Makefile
@@ -10,13 +10,13 @@ MPC_VER = 1.3.1
 MPFR_VER = 4.2.2
 LINUX_VER = headers-4.19.88-2
 
-GNU_SITE = https://ftpmirror.gnu.org/gnu
+GNU_SITE = https://mirror.lyrahosting.com/gnu
 GCC_SITE = $(GNU_SITE)/gcc
 BINUTILS_SITE = $(GNU_SITE)/binutils
 GMP_SITE = $(GNU_SITE)/gmp
 MPC_SITE = $(GNU_SITE)/mpc
 MPFR_SITE = $(GNU_SITE)/mpfr
-ISL_SITE = https://downloads.sourceforge.net/project/libisl/
+ISL_SITE = https://libisl.sourceforge.io
 
 MUSL_SITE = https://musl.libc.org/releases
 MUSL_REPO = https://git.musl-libc.org/git/musl
